#!/usr/bin/env bash
#
# Transparent cargo shim: routes the expensive subcommands through lockout and
# passes everything else straight to the real cargo.
#
# Put this directory FIRST on PATH:
#     export PATH="/path/to/lockout/shim:$PATH"
#
# Anything that does not compile (`cargo add`, `cargo fmt`, `cargo metadata`)
# is not worth queueing and goes straight through, so interactive work stays
# responsive while a build holds the slot.

set -uo pipefail

SHIM_DIR=$(cd -P "$(dirname "$0")" >/dev/null 2>&1 && pwd)

# The first cargo on PATH that is not this shim. Comparing resolved directories
# rather than paths keeps a symlinked shim dir from shadowing itself forever.
find_real_cargo() {
  local oldifs=$IFS p rp c
  IFS=:
  for p in $PATH; do
    IFS=$oldifs
    [ -n "$p" ] || p=.
    c=$p/cargo
    if [ -x "$c" ] && [ ! -d "$c" ]; then
      rp=$(cd -P "$p" >/dev/null 2>&1 && pwd) || rp=""
      if [ "$rp" != "$SHIM_DIR" ]; then printf '%s' "$c"; return 0; fi
    fi
    IFS=:
  done
  IFS=$oldifs
  return 1
}

REAL=${CARGO_REAL:-$(find_real_cargo)}
if [ -z "$REAL" ]; then
  printf 'cargo shim: no real cargo found on PATH (is %s the only one?)\n' "$SHIM_DIR" >&2
  exit 127
fi

# Per-agent cargo home. Cargo's package-cache lock is per $CARGO_HOME, so
# agents sharing one home serialize. The runtime (mush) sets BOB_AGENT_KEY;
# when it is absent, fpl-bob derives a key from the worktree containing the
# CWD. An explicit CARGO_HOME always wins, and a missing fpl-bob must never
# break a build.
if [ -z "${CARGO_HOME:-}" ] && [ -z "${BOB_NO_CARGO_HOME:-}" ]; then
  if bob=$(command -v fpl-bob 2>/dev/null); then
    if [ -n "${BOB_AGENT_KEY:-}" ]; then
      bob_home=$("$bob" cargo-home --key "$BOB_AGENT_KEY" 2>/dev/null)
    else
      bob_home=$("$bob" cargo-home 2>/dev/null)
    fi
    [ -n "${bob_home:-}" ] && export CARGO_HOME=$bob_home
  fi
fi

# Network filesystems cannot host cargo's target/. Ask bob where it goes.
if [ -z "${CARGO_TARGET_DIR:-}" ] && [ -z "${BOB_NO_TARGET_DIR:-}" ]; then
  if bob=$(command -v fpl-bob 2>/dev/null); then
    target_dir=$("$bob" cargo-target 2>/dev/null)
    if [ -n "$target_dir" ]; then
      export CARGO_TARGET_DIR=$target_dir
      mkdir -p "$CARGO_TARGET_DIR"
      echo "bob: network workspace; CARGO_TARGET_DIR=$CARGO_TARGET_DIR" >&2
    fi
  fi
fi

# Prefer the lockout next to this shim; fall back to whatever is on PATH.
if [ -x "$SHIM_DIR/../bin/lockout" ]; then
  LOCKOUT=$SHIM_DIR/../bin/lockout
else
  LOCKOUT=$(command -v lockout 2>/dev/null)
fi
[ -n "$LOCKOUT" ] || exec "$REAL" "$@"   # no lockout installed: never block work

# The subcommand, looking past a +toolchain argument.
sub=${1:-}
case $sub in +*) sub=${2:-} ;; esac

case $sub in
  # Compiling subcommands: these are the ones that saturate the machine.
  # `run` is deliberately absent -- it compiles and then runs your program,
  # often for a long time, and holding a build slot for that is wrong.
  build|b|test|t|check|c|clippy|bench|doc|rustc|nextest|miri)
    exec "$LOCKOUT" run -t "cargo $sub" -- "$REAL" "$@"
    ;;
  *)
    exec "$REAL" "$@"
    ;;
esac
