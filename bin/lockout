#!/usr/bin/env bash
#
# lockout - a portable FIFO job queue / counting semaphore for expensive builds.
#
# Keeps concurrent `cargo build` / `cargo test` (or anything else expensive)
# at or below a set limit, queues the rest first-come-first-served, and gives
# humans and agents a way to watch what is happening.
#
# Dependencies: bash 3.2+ and a POSIX userland. Nothing else.
# Mutual exclusion is built on mkdir(2), which is atomic on every filesystem
# worth using -- flock(1) does not exist on macOS.

set -uo pipefail

VERSION=0.2.0
PROG=lockout

# ---------------------------------------------------------------- helpers ---

die()   { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn()  { printf '%s: %s\n' "$PROG" "$*" >&2; }
now()   { date +%s; }
alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

# Read the first line of a file into $RF without forking. Hot-path helper:
# the poll loop runs this hundreds of times and $(cat) would fork every time.
RF=
rf() { RF=""; [ -f "$1" ] || return 0; IFS= read -r RF < "$1" 2>/dev/null || :; return 0; }

NL=$'\n'

# The identity of a live process: the moment the kernel started it.
#
# A pid is not an identity, it is a number the kernel hands out again. Start
# time is the part of a process that pid reuse cannot copy, and `ps` already has
# to be on the box for kill_tree, so this costs no new dependency.
#
# Empty means "no process a job could still be running under", which covers the
# case `kill -0` gets wrong: a zombie. A process killed while its parent never
# wait()s stays in the table as <defunct> and answers kill -0 forever.
#
# Used only when recording a job, once. Checking uses the snapshot below.
proc_ident() { # pid -> stdout token, empty when there is no usable process
  local line st
  [ -n "${1:-}" ] || return 0
  line=$(ps -o state=,lstart= -p "$1" 2>/dev/null) || return 0
  [ -n "$line" ] || return 0
  st=${line%% *}
  case $st in Z*) return 0 ;; esac      # <defunct>: the owner is already gone
  line=${line#"$st"}
  printf '%s' "${line// /}"
  return 0
}

# `ps -ax` walks the whole process table and can block for minutes on a loaded
# machine. That is not hypothetical: on the Mac Studio this budget was written
# for, `ps -ax -o pid=` timed out at 30s while `ps -p PID` and `pgrep -P 1`
# answered instantly (docs/evidence/2026-10-22-baseline.md). A build budget must
# never hang on the very condition it exists to prevent, so lockout never walks
# the table: every liveness question is asked about one known pid, and every
# burn-rate question about one known process group.
#
# One probe decides whether `ps` is usable at all. If it is not, degrade to the
# old weaker presence check rather than declaring every live job abandoned.
PS_OK=-1
ps_works() { # 0 when per-pid ps answers
  [ "$PS_OK" -ge 0 ] && return "$PS_OK"
  if [ -n "$(ps -p $$ -o pid= 2>/dev/null)" ]; then
    PS_OK=0
  else
    PS_OK=1
    warn "ps cannot report process state; falling back to pid-presence checks"
  fi
  return "$PS_OK"
}

# Is the process that owns a job still running it?
#
# `alive` answers a weaker question -- "does SOME process hold this pid" -- and
# the queue's central promise (a dead agent cannot wedge the queue) rests on the
# stronger one. Two ways the weak answer lies, both seen on a machine running
# several agents:
#
#   - zombies: an agent harness torn down mid-build leaves the lockout wrapper
#     killed but unreaped. kill -0 succeeds on <defunct> forever, so its slot is
#     never freed and the queue wedges permanently.
#   - pid reuse: a few parallel cargo builds burn the whole pid space in about
#     twenty minutes, so a dead owner's number is handed to an unrelated process
#     and its slot stays held for as long as that stranger happens to live.
#
# Records written by an older lockout carry no identity token; those keep the
# old presence check rather than being reaped on a guess.
owner_alive() { # pid token -> 0 when the owner is still running
  local pid=${1:-} want=${2:-} cur
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null || return 1   # builtin, free, and the usual answer
  ps_works || return 0                     # no identity to check against
  cur=$(proc_ident "$pid")
  [ -n "$cur" ] || return 1                # gone, or <defunct>
  [ -n "$want" ] || return 0               # legacy record: presence is all there is
  [ "$cur" = "$want" ] && return 0
  return 1                                 # the number was recycled onto a stranger
}

NO_DEDUPE=0
EXCLUSIVE=""
JOB_KEY=""

# Quote a string for display so a logged command can be pasted back into a
# shell verbatim. Uses printf %q rather than a pattern substitution: bash 3.2
# and 5.x disagree about backslashes in a substitution replacement, and %q is
# the one form that means the same thing in both.
shquote() {
  local s=${1-}
  case $s in
    ''|*[!A-Za-z0-9_.:/=@%+,-]*) printf '%q' "$s" ;;
    *) printf '%s' "$s" ;;
  esac
}

json_escape() {
  local s=${1-}
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/}
  printf '%s' "$s"
}

# Seconds -> M:SS or H:MM:SS
hms() {
  local t=${1:-0} h m s
  case $t in ''|*[!0-9]*) t=0 ;; esac
  h=$((t / 3600)); m=$(((t % 3600) / 60)); s=$((t % 60))
  if [ "$h" -gt 0 ]; then printf '%d:%02d:%02d' "$h" "$m" "$s"
  else printf '%d:%02d' "$m" "$s"; fi
}

# Absolute path to this script, following symlinks (macOS has no readlink -f).
self_path() {
  local src=$0 dir
  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    src=$(readlink "$src")
    case $src in /*) : ;; *) src=$dir/$src ;; esac
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  printf '%s/%s' "$dir" "$(basename "$src")"
}

# ------------------------------------------------------------------ state ---

SCOPE=${LOCKOUT_SCOPE:-default}
SCOPE=${SCOPE//\//_}
[ -n "$SCOPE" ] || SCOPE=default

if [ -n "${LOCKOUT_HOME:-}" ]; then
  HOME_DIR=$LOCKOUT_HOME
elif [ -n "${XDG_STATE_HOME:-}" ]; then
  HOME_DIR=$XDG_STATE_HOME/lockout
else
  HOME_DIR=$HOME/.local/state/lockout
fi

SCOPE_DIR=$HOME_DIR/$SCOPE
JOBS_DIR=$SCOPE_DIR/jobs
CTL=$SCOPE_DIR/ctl.lock
RETENTION=${LOCKOUT_RETENTION:-3600}   # seconds to keep finished jobs visible
US=$'\037'                             # field separator for status rows

init_state() {
  mkdir -p "$JOBS_DIR" 2>/dev/null || die "cannot create state dir: $JOBS_DIR"
}

# ---------------------------------------------------- control-lock (mutex) ---

CTL_HELD=0

ctl_acquire() {
  local tries=0 opid
  while :; do
    if mkdir "$CTL" 2>/dev/null; then
      printf '%s %s\n' "$$" "$(now)" > "$CTL/owner" 2>/dev/null
      CTL_HELD=1
      return 0
    fi
    # The holder died mid-section: reclaim it rather than wedging forever.
    if [ -f "$CTL/owner" ]; then
      opid=""
      rf "$CTL/owner"; opid=${RF%% *}
      if [ -n "$opid" ] && ! alive "$opid"; then
        warn "reclaiming control lock from dead pid $opid"
        rm -rf "$CTL" 2>/dev/null
        continue
      fi
    fi
    tries=$((tries + 1))
    # Critical sections are microseconds; 30s of contention means something
    # is wedged (e.g. killed -9 between mkdir and writing owner).
    if [ "$tries" -gt 600 ]; then
      warn "breaking control lock after 30s with no progress"
      rm -rf "$CTL" 2>/dev/null
      tries=0
      continue
    fi
    sleep 0.05
  done
}

ctl_release() {
  [ "$CTL_HELD" = 1 ] || return 0
  CTL_HELD=0
  rm -rf "$CTL" 2>/dev/null
  return 0
}

# ------------------------------------------------------------ job records ---
# One directory per job, one file per field. Field writes go through a temp
# file + mv so a reader never sees a half-written value.

setf() { # id field value
  local d=$JOBS_DIR/$1 t
  [ -d "$d" ] || return 0
  t=$d/.tmp.$2.$$
  printf '%s\n' "$3" > "$t" 2>/dev/null && mv -f "$t" "$d/$2" 2>/dev/null
  return 0
}

getf() { # id field  -> stdout
  local f=$JOBS_DIR/$1/$2
  [ -f "$f" ] && cat "$f" 2>/dev/null
  return 0
}

# Record who owns a job: the pid, plus the identity the reaper verifies it
# against. Pid and token live in one field on purpose -- written separately, a
# reader could pair a freshly written pid with a stale token and reap a healthy
# job. `pid` stays a bare number for status, cancel and every existing reader.
set_owner() { # id pid
  setf "$1" pid "$2"
  setf "$1" owner "$2 $(proc_ident "$2")"
  return 0
}

# Read a job's recorded owner into $OPID / $OTOK, in the style of rf/$RF.
OPID=; OTOK=
job_owner() { # job-dir
  OPID=""; OTOK=""
  rf "$1/owner"
  case $RF in
    '')    rf "$1/pid"; OPID=$RF ;;              # written by an older lockout
    *' '*) OPID=${RF%% *}; OTOK=${RF#* } ;;
    *)     OPID=$RF ;;
  esac
  return 0
}

get_limit() {
  local n=${LOCKOUT_LIMIT:-}
  if [ -z "$n" ]; then rf "$SCOPE_DIR/limit"; n=$RF; fi
  [ -n "$n" ] || n=1
  case $n in ''|*[!0-9]*) die "invalid limit: '$n' (want a positive integer)" ;; esac
  [ "$n" -ge 1 ] || die "invalid limit: $n (want a positive integer)"
  printf '%s' "$n"
}

# ------------------------------------------------------- build budget ------
#
# The queue above answers "how many builds at once". The budget answers the two
# questions that actually took the machine down: how many kernel tasks are left,
# and how much CPU / memory / process fan-out / wall time may one job consume.
# It is the same artefact and the same job record -- not a second limiter.
#
# Values are stored in integer units so bash 3.2 arithmetic is exact:
#   cpu_quota  millicpus (2000 = two cores; 500 = half a core)
#   mem_cap    bytes
#   children   maximum descendants (0 = unlimited)
#   timeout    seconds (0 = none)

B_CPU=0; B_MEM=0; B_CHILDREN=0; B_TIMEOUT=0; B_TASK_GATE=${LOCKOUT_TASK_GATE:-on}
TASK_REASON=""

cpu_milli() { # "2" | "0.5" -> millicpus
  local v=${1:-} a b
  case $v in
    ''|*[!0-9.]*|*.*.*) die "invalid cpu quota: '$v' (want e.g. 2 or 0.5)" ;;
  esac
  case $v in
    *.*) a=${v%%.*}; b=${v#*.}; b="${b}000"; b=${b:0:3} ;;
    *)   a=$v; b=000 ;;
  esac
  [ -n "$a" ] || a=0
  printf '%s' $((10#$a * 1000 + 10#$b))
}

mem_bytes() { # 512M | 2G | 1048576 -> bytes
  local v=${1:-} n mul=1
  case $v in
    *[Kk]) n=${v%?}; mul=1024 ;;
    *[Mm]) n=${v%?}; mul=1048576 ;;
    *[Gg]) n=${v%?}; mul=1073741824 ;;
    *)     n=$v ;;
  esac
  case $n in ''|*[!0-9]*) die "invalid mem cap: '$v' (want e.g. 512M, 2G or bytes)" ;; esac
  printf '%s' $((10#$n * mul))
}

time_secs() { # 30 | 90s | 30m | 2h -> seconds
  local v=${1:-} n mul=1
  case $v in
    *[Ss]) n=${v%?}; mul=1 ;;
    *[Mm]) n=${v%?}; mul=60 ;;
    *[Hh]) n=${v%?}; mul=3600 ;;
    *)     n=$v ;;
  esac
  case $n in ''|*[!0-9]*) die "invalid timeout: '$v' (want e.g. 90, 30m or 2h)" ;; esac
  printf '%s' $((10#$n * mul))
}

load_budget_defaults() { # env (human units) > scope files (canonical) > none
  local v
  # The scope files store canonical units: millicpus, bytes, seconds. Env vars
  # accept human units. Mixing the two here is how "2 cores" becomes 2000 cores.
  if [ -n "${LOCKOUT_CPU_QUOTA:-}" ]; then
    B_CPU=$(cpu_milli "$LOCKOUT_CPU_QUOTA")
  else
    rf "$SCOPE_DIR/cpu_quota"; v=$RF
    case ${v:-0} in ''|*[!0-9]*) die "invalid stored cpu quota: '$v'" ;; esac
    B_CPU=$((10#${v:-0}))
  fi
  if [ -n "${LOCKOUT_MEM_CAP:-}" ]; then
    B_MEM=$(mem_bytes "$LOCKOUT_MEM_CAP")
  else
    rf "$SCOPE_DIR/mem_cap"; v=$RF
    case ${v:-0} in ''|*[!0-9]*) die "invalid stored mem cap: '$v'" ;; esac
    B_MEM=$((10#${v:-0}))
  fi
  v=${LOCKOUT_CHILDREN:-}; [ -n "$v" ] || { rf "$SCOPE_DIR/children"; v=$RF; }
  case ${v:-0} in ''|*[!0-9]*) die "invalid children cap: '$v'" ;; esac
  B_CHILDREN=$((10#${v:-0}))
  if [ -n "${LOCKOUT_TIMEOUT:-}" ]; then
    B_TIMEOUT=$(time_secs "$LOCKOUT_TIMEOUT")
  else
    rf "$SCOPE_DIR/timeout"; v=$RF
    case ${v:-0} in ''|*[!0-9]*) die "invalid stored timeout: '$v'" ;; esac
    B_TIMEOUT=$((10#${v:-0}))
  fi
  v=${LOCKOUT_TASK_GATE:-}; [ -n "$v" ] || { rf "$SCOPE_DIR/task_gate"; v=$RF; }
  B_TASK_GATE=${v:-on}
  case $B_TASK_GATE in on|warn|off) : ;; *) die "invalid task gate: '$B_TASK_GATE' (on|warn|off)" ;; esac
}

budget_flag() { # option value -> sets B_*
  case $1 in
    --cpu-quota) B_CPU=$(cpu_milli "$2") ;;
    --mem-cap)   B_MEM=$(mem_bytes "$2") ;;
    --children)  case ${2:-} in ''|*[!0-9]*) die "invalid children cap: '$2'" ;; esac
                 B_CHILDREN=$((10#$2)) ;;
    --timeout)   B_TIMEOUT=$(time_secs "$2") ;;
    --task-gate) case ${2:-} in on|warn|off) B_TASK_GATE=$2 ;; *) die "invalid task gate: '$2' (on|warn|off)" ;; esac ;;
    *) return 1 ;;
  esac
  return 0
}

job_budget() { # id -> load the job's frozen budget into B_*
  rf "$JOBS_DIR/$1/cpu_quota"; B_CPU=${RF:-0}
  rf "$JOBS_DIR/$1/mem_cap";   B_MEM=${RF:-0}
  rf "$JOBS_DIR/$1/children";  B_CHILDREN=${RF:-0}
  rf "$JOBS_DIR/$1/timeout";   B_TIMEOUT=${RF:-0}
  rf "$JOBS_DIR/$1/task_gate"; B_TASK_GATE=${RF:-on}
  return 0
}

# How many kernel tasks are in use?
#
# Never `ps`: it is the tool that hangs when the table is under pressure. pgrep
# reads the same table but has been observed to answer while ps blocks. A count
# that cannot be measured is not headroom -- the gate fails closed.
# Run a command with a hard wall cap, capturing stdout. No `timeout(1)` on macOS.
run_capped() { # seconds outfile cmd...
  local secs=$1 out=$2 p i=0 max; shift 2
  max=$((secs * 10))
  ( "$@" >"$out" 2>/dev/null ) & p=$!
  while kill -0 "$p" 2>/dev/null; do
    if [ "$i" -ge "$max" ]; then
      kill -9 "$p" 2>/dev/null
      return 124
    fi
    sleep 0.1; i=$((i + 1))
  done
  wait "$p" 2>/dev/null; return $?
}

task_count() {
  local out tf rc at n t now
  if [ -n "${LOCKOUT_TASK_COUNT:-}" ]; then
    case $LOCKOUT_TASK_COUNT in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$LOCKOUT_TASK_COUNT"; return 0
  fi
  # A submit must not pay for a 1600-process scan every time. A short cached
  # count keeps admission fast while still noticing a filling table within the
  # TTL; the 64-task reserve absorbs the staleness.
  t=${LOCKOUT_TASK_CACHE_TTL:-5}
  case $t in ''|*[!0-9]*) t=5 ;; esac
  now=$(now)
  rf "$HOME_DIR/task_count_at"; at=$RF
  rf "$HOME_DIR/task_count";    n=$RF
  case ${at:-x} in *[!0-9]*) at=0 ;; esac
  case ${n:-x}  in ''|*[!0-9]*) n=0 ;; esac
  if [ "$n" -gt 0 ] && [ $((now - at)) -lt "$t" ]; then
    printf '%s' "$n"; return 0
  fi
  tf=$(mktemp "${TMPDIR:-/tmp}/lockout-tasks.XXXXXX") || return 1
  run_capped 3 "$tf" pgrep .; rc=$?
  out=$(wc -l < "$tf" | tr -d ' '); rm -f "$tf"
  [ "$rc" = 0 ] || return 1
  case $out in ''|*[!0-9]*|0) return 1 ;; esac
  printf '%s\n' "$out" > "$HOME_DIR/task_count" 2>/dev/null
  printf '%s\n' "$now" > "$HOME_DIR/task_count_at" 2>/dev/null
  printf '%s' "$out"
}

task_ceiling() { # the tighter of the kernel's two advertised ceilings
  local a b
  if [ -n "${LOCKOUT_TASK_CEILING:-}" ]; then
    case $LOCKOUT_TASK_CEILING in ''|*[!0-9]*) return 1 ;; esac
    printf '%s' "$LOCKOUT_TASK_CEILING"; return 0
  fi
  a=$(sysctl -n kern.num_tasks 2>/dev/null)
  b=$(sysctl -n kern.maxproc 2>/dev/null)
  case $a in ''|*[!0-9]*) a=0 ;; esac
  case $b in ''|*[!0-9]*) b=0 ;; esac
  [ "$a" -gt 0 ] || a=$b
  [ "$b" -gt 0 ] || b=$a
  [ "$a" -gt 0 ] || return 1
  [ "$a" -lt "$b" ] && { printf '%s' "$a"; return 0; }
  printf '%s' "$b"
}

task_headroom() { # stdout headroom, or empty when unmeasurable
  local n c
  n=$(task_count) || return 1
  c=$(task_ceiling) || return 1
  printf '%s' $((c - n))
}

task_gate_check() { # requested-children -> 0 when there is room to spawn
  local want=${1:-0} head need reserve
  reserve=${LOCKOUT_TASK_HEADROOM:-64}
  case $reserve in ''|*[!0-9]*) reserve=64 ;; esac
  TASK_REASON=""
  head=$(task_headroom) || {
    TASK_REASON="kernel task table unmeasurable (ps/pgrep blocked)"
    return 1
  }
  need=$((want + reserve))
  if [ "$head" -lt "$need" ]; then
    TASK_REASON="kernel task table headroom ${head} < ${need} (children ${want} + reserve ${reserve})"
    return 1
  fi
  return 0
}

# Resolve the build output directory a command will contend on.
#
# Cargo takes an exclusive lock on its target directory, so two jobs sharing one
# can never run at the same time. Admitting both wastes a slot on a process that
# only sleeps. Resolve to an absolute path so equivalent invocations from
# different working directories are recognised as the same resource, and so an
# unset CARGO_TARGET_DIR still collides with an explicit one naming the same dir.
resolve_exclusive() { # -> stdout (absolute path, or empty when not determinable)
  local dir="" probe
  if [ -n "${CARGO_TARGET_DIR:-}" ]; then
    dir=$CARGO_TARGET_DIR
  else
    # Cargo's default is <workspace root>/target. Walk up to the outermost
    # Cargo.toml so a member and its workspace resolve to one directory.
    probe=$PWD
    while [ "$probe" != / ] && [ -n "$probe" ]; do
      [ -f "$probe/Cargo.toml" ] && dir=$probe/target
      probe=$(dirname "$probe")
    done
  fi
  [ -n "$dir" ] || return 0
  # Absolute-ise without requiring the directory to exist yet.
  case $dir in
    /*) : ;;
    *)  dir=$PWD/$dir ;;
  esac
  ( cd "$(dirname "$dir")" 2>/dev/null && printf '%s/%s' "$(pwd -P)" "$(basename "$dir")" ) 2>/dev/null \
    || printf '%s' "$dir"
  return 0
}

# A fingerprint for "these two jobs would produce the same verdict".
#
# Never the command text alone. `cargo clippy --workspace --all-targets` with and
# without RUSTFLAGS=-D warnings are different checks that disagree on identical
# source; collapsing them would reintroduce the bug this queue exists to avoid.
job_key() { # exclusive cmd -> stdout
  # One line, always: job records are read with rf(), which returns only the
  # first line. A multi-line key silently compares its first field against a
  # whole key and never matches, which defeats dedupe without failing.
  printf '%s%s%s%s%s%s%s%s%s' "$1" "$US" "$2" "$US" "$PWD" "$US" \
    "${RUSTFLAGS:-}" "$US" \
    "${CARGO_BUILD_JOBS:-}/${CARGO_INCREMENTAL:-}/${CARGO_PROFILE_DEV_DEBUG:-}"
}

# A queued job with the same fingerprint, if any. Deliberately queued-only:
# a RUNNING job read the working tree when it started, so a submission arriving
# after an edit must not be handed its result. A queued job has read nothing yet,
# so whenever it runs it observes the tree both callers actually asked about.
duplicate_queued() { # key -> stdout (job id, or empty)
  local d key=$1
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    rf "$d/state"; [ "$RF" = queued ] || continue
    rf "$d/key";   [ "$RF" = "$key" ] || continue
    d=${d%/}; printf '%s' "${d##*/}"; return 0
  done
  return 0
}

# Is some other job already running against this exclusive resource?
exclusive_busy() { # id exclusive -> 0 when blocked
  local self=$1 res=$2 d b
  [ -n "$res" ] || return 1
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    b=${d%/}; b=${b##*/}
    [ "$b" = "$self" ] && continue
    rf "$d/state"; [ "$RF" = running ] || continue
    rf "$d/exclusive"; [ "$RF" = "$res" ] && return 0
  done
  return 1
}

# All of the below assume the caller holds the control lock.

count_state() { # state -> stdout
  local n=0 d
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    rf "$d/state"
    [ "$RF" = "$1" ] && n=$((n + 1))
  done
  printf '%s' "$n"
  return 0
}

oldest_queued() { # -> stdout (job id, or empty). Glob order is lexical, and
                  # ids are zero-padded tickets, so first match == oldest.
                  #
                  # Skips a job whose exclusive resource is busy: it cannot start
                  # anyway, and letting it hold the head of the queue would stall
                  # every job behind it on a lock it does not need. FIFO still
                  # holds among jobs that could actually run.
  local d b res
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    rf "$d/state"
    [ "$RF" = queued ] || continue
    b=${d%/}; b=${b##*/}
    rf "$d/exclusive"; res=$RF
    exclusive_busy "$b" "$res" && continue
    printf '%s' "$b"; return 0
  done
  return 0
}

queue_position() { # id -> stdout (1-based position among queued jobs)
  local id=$1 n=0 d b
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    rf "$d/state"
    [ "$RF" = queued ] || continue
    n=$((n + 1))
    b=${d%/}; b=${b##*/}
    [ "$b" = "$id" ] && { printf '%s' "$n"; return 0; }
  done
  printf '%s' "$n"
  return 0
}

# Free slots held by processes that died, and prune old finished jobs so the
# state dir does not grow without bound.
reap() {
  local d id st ended t
  t=$(now)
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    id=${d%/}; id=${id##*/}
    rf "$d/state"; st=$RF
    case $st in
      queued|running)
        # owner_alive, not alive: a pid that still answers kill -0 may be a
        # zombie or a stranger that inherited the number. Either one holds the
        # slot for as long as it lives, which is the wedge this reaper exists
        # to prevent.
        job_owner "$d"
        if ! owner_alive "$OPID" "$OTOK"; then
          setf "$id" state "done"
          setf "$id" exit 254
          setf "$id" ended "$t"
          setf "$id" note "abandoned (pid ${OPID:-?} vanished)"
        fi
        ;;
      done)
        rf "$d/ended"; ended=$RF
        case $ended in ''|*[!0-9]*) ended=0 ;; esac
        if [ "$RETENTION" -ge 0 ] && [ $((t - ended)) -gt "$RETENTION" ]; then
          rm -rf "$d" 2>/dev/null
        fi
        ;;
      *)
        # A job dir with no state file is a half-built record from a crashed
        # enqueue; drop it once it is clearly not in flight.
        job_owner "$d"
        owner_alive "$OPID" "$OTOK" || rm -rf "$d" 2>/dev/null
        ;;
    esac
  done
  return 0
}

# ------------------------------------------------------- enqueue / acquire ---

JOB_ID=""
CHILD_PID=""

# Where a job came from, preferring a crate name over a long path.
#
# A column of absolute paths is hard to scan and mostly redundant prefix; the
# crate is what a reader actually wants to identify. Falls back to the path when
# there is no package to name, so the column never goes blank.
job_where() { # cwd -> stdout
  local dir=$1 line in_package=0 name=""
  [ -n "$dir" ] || { printf '-'; return 0; }
  if [ -f "$dir/Cargo.toml" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      case $line in
        '[package]'*)  in_package=1 ;;
        '['*)          [ "$in_package" = 1 ] && break ;;
        name*=*)
          if [ "$in_package" = 1 ]; then
            name=${line#*=}
            name=${name#"${name%%[![:space:]]*}"}   # ltrim
            name=${name%\"}; name=${name#\"}
            break
          fi ;;
      esac
    done < "$dir/Cargo.toml"
  fi
  [ -n "$name" ] && { printf '%s' "$name"; return 0; }
  # A workspace root has no [package] to name, and a full path is long enough to
  # break the column. The last segment identifies it well enough to scan; --json
  # still carries the absolute cwd for anything that needs it.
  printf '%s' "${dir##*/}"
  return 0
}

job_cmd_text() { # cmd... -> stdout (same quoting enqueue records)
  local a out=""
  for a in "$@"; do out="$out $(shquote "$a")"; done
  printf '%s' "${out# }"
}

enqueue() { # mode tag cmd... -> stdout job id
  local mode=$1 tag=$2; shift 2
  local n id d cmd=""
  for a in "$@"; do cmd="$cmd $(shquote "$a")"; done
  cmd=${cmd# }
  EXCLUSIVE=$(resolve_exclusive)
  JOB_KEY=$(job_key "$EXCLUSIVE" "$cmd")

  ctl_acquire
  rf "$SCOPE_DIR/seq"; n=$RF
  case $n in ''|*[!0-9]*) n=0 ;; esac
  n=$((n + 1))
  printf '%s\n' "$n" > "$SCOPE_DIR/seq"
  id=$(printf '%06d' "$n")
  d=$JOBS_DIR/$id
  mkdir -p "$d" || { ctl_release; die "cannot create job dir: $d"; }
  # $$ inside this command substitution is still the wrapper's own pid, which
  # is the process whose death has to free the slot.
  set_owner "$id" "$$"
  setf "$id" cmd "$cmd"
  setf "$id" cwd "$PWD"
  setf "$id" mode "$mode"
  setf "$id" tag "$tag"
  setf "$id" exclusive "$EXCLUSIVE"
  setf "$id" key "$JOB_KEY"
  setf "$id" cpu_quota "$B_CPU"
  setf "$id" mem_cap "$B_MEM"
  setf "$id" children "$B_CHILDREN"
  setf "$id" timeout "$B_TIMEOUT"
  setf "$id" task_gate "$B_TASK_GATE"
  setf "$id" queued_at "$(now)"
  setf "$id" state queued          # written last: the record is now live
  ctl_release
  printf '%s' "$id"
}

# Block until this job owns a slot. Returns 0 on success, 130 if cancelled.
acquire_slot() { # id
  local id=$1 limit running head pos last_reap=-99 last_note=0 waited=0 poll res
  local start=$SECONDS
  while :; do
    if [ -f "$JOBS_DIR/$id/cancel" ]; then
      finish "$id" 130 "cancelled while queued"
      return 130
    fi

    ctl_acquire
    limit=$(get_limit)
    # Reaping walks every job's owner. Do it when the queue is actually full
    # (the only time a dead owner blocks work) rather than on the admission path
    # of every new job -- otherwise short jobs serialise behind ps calls.
    if [ $((SECONDS - last_reap)) -ge 2 ]; then
      if [ "$(count_state running)" -ge "$limit" ]; then reap; fi
      last_reap=$SECONDS
    fi
    running=$(count_state running)
    head=$(oldest_queued)
    rf "$JOBS_DIR/$id/exclusive"; res=$RF
    if [ "$running" -lt "$limit" ] && [ "$head" = "$id" ] && ! exclusive_busy "$id" "$res"; then
      setf "$id" state running
      setf "$id" started "$(now)"
      ctl_release
      return 0
    fi
    pos=$(queue_position "$id")
    ctl_release

    waited=$((SECONDS - start))
    # Keep a blocked agent informed without spamming its transcript.
    if [ "$QUIET" != 1 ] && [ $((waited - last_note)) -ge 15 ]; then
      last_note=$waited
      printf '%s: [%s] queued - position %s, %s running (limit %s), waiting %s\n' \
        "$PROG" "$id" "$pos" "$running" "$limit" "$(hms "$waited")" >&2
    fi

    # Snappy while a slot is likely to free up soon, cheap once it is clear
    # we are in for a long wait.
    if   [ "$waited" -lt 2 ];  then poll=0.05
    elif [ "$waited" -lt 60 ]; then poll=0.25
    else poll=1
    fi
    sleep "$poll"
  done
}

# Signal a process and everything it spawned. Killing only the recorded child is
# not enough: TERM to `cargo build` (or to any `sh -c` wrapper) does not
# necessarily reach the rustc processes underneath it, and a cancelled build
# that keeps eating cores defeats the whole point.
#
# Every budgeted job runs in its own process group (`set -m` below), so one
# group signal reaches the whole tree without walking the process table -- the
# walk that hangs under load. Legacy jobs started before 0.2.0 fall back to
# signalling the root only, never the caller's own group.
kill_tree() { # root-pid signal
  local root=${1:-} sig=${2:-TERM} pgid mine
  [ -n "$root" ] || return 0
  mine=$(ps -o pgid= -p $$ 2>/dev/null | tr -d ' ')
  pgid=$(ps -o pgid= -p "$root" 2>/dev/null | tr -d ' ')
  case $pgid in
    ''|*[!0-9]*) pgid="" ;;
  esac
  if [ -n "$pgid" ] && [ "$pgid" != "$mine" ] && [ "$pgid" != "$$" ]; then
    kill -"$sig" -- "-$pgid" 2>/dev/null   # leaves first is the kernel's job
    return 0
  fi
  [ "$root" = "$$" ] && return 0
  kill -"$sig" "$root" 2>/dev/null
  return 0
}

# One process-group snapshot: "count rss_kb cpu_ticks" (ticks = centiseconds).
# ps -g only touches the named group, so it sidesteps the full-table walk.
group_stats() { # pgid -> stdout
  local out
  out=$(ps -g "$1" -o pid=,rss=,time= 2>/dev/null) || { printf '0 0 0'; return 0; }
  printf '%s\n' "$out" | awk '
    function ticks(t,   a,n,c) {
      n=split(t,a,":");
      if (n==3) { split(a[3],c,"."); return (a[1]*3600+a[2]*60+c[1])*100 + (length(c[2])==1 ? c[2]*10 : c[2]+0) }
      split(a[2],c,"."); return (a[1]*60+c[1])*100 + (length(c[2])==1 ? c[2]*10 : c[2]+0)
    }
    NF { n++; rss+=$2; cpu+=ticks($3) }
    END { printf "%d %d %d\n", n, rss, cpu }'
}

# Duty-cycle a group that is burning more than its quota. SIGSTOP/SIGCONT is the
# only portable CPU cap on macOS (no cgroups); stopping for the overshoot
# fraction of the window drives the average back to the quota.
throttle_group() { # pgid observed_millicpus quota_millicpus [remaining_ms]
  local pgid=$1 rate=$2 quota=$3 remain=${4:-0} stop_ms
  [ "$rate" -gt 0 ] && [ "$quota" -gt 0 ] || return 0
  # The window just ran for one second at `rate`. To make the average `quota`
  # over (1s + stop), stop for (rate-quota)/quota seconds -- not /rate, which
  # under-throttles badly when a build fans out to every core.
  stop_ms=$((1000 * (rate - quota) / quota))
  [ "$stop_ms" -gt 5000 ] && stop_ms=5000
  if [ "$remain" -gt 0 ] && [ "$stop_ms" -gt "$remain" ]; then stop_ms=$remain; fi
  [ "$stop_ms" -ge 50 ] || return 0
  kill -STOP -- "-$pgid" 2>/dev/null || return 0
  sleep "$(printf '%d.%03d' $((stop_ms / 1000)) $((stop_ms % 1000)))"
  kill -CONT -- "-$pgid" 2>/dev/null
  return 0
}

finish() { # id exit-code [note]
  local id=$1 rc=$2 note=${3:-} st
  [ -n "$id" ] || return 0
  [ -d "$JOBS_DIR/$id" ] || return 0
  ctl_acquire
  rf "$JOBS_DIR/$id/state"; st=$RF
  if [ "$st" != "done" ]; then
    setf "$id" exit "$rc"
    setf "$id" ended "$(now)"
    [ -n "$note" ] && setf "$id" note "$note"
    setf "$id" state "done"
  fi
  ctl_release
  return 0
}

on_exit() {
  local rc=$?
  ctl_release
  # Safety net: never leave a slot held by a process that is gone.
  [ -n "$JOB_ID" ] && finish "$JOB_ID" "$rc" "exited without releasing"
  return 0
}

on_signal() { # signame signum
  local sig=$1 num=$2 i=0
  if [ -n "$CHILD_PID" ] && alive "$CHILD_PID"; then
    kill_tree "$CHILD_PID" "$sig"
    while alive "$CHILD_PID" && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    alive "$CHILD_PID" && kill_tree "$CHILD_PID" KILL
  fi
  finish "$JOB_ID" $((128 + num)) "received SIG$sig"
  JOB_ID=""
  exit $((128 + num))
}

# Supervise one running job against its frozen budget. The child is in its own
# process group, so CPU, RSS and fan-out are measured without a table walk.
# Returns the job's exit code, or the budget's code when it had to stop it:
#   124 timeout   125 too many children   137 memory cap
supervise() { # id pid
  local id=$1 pid=$2 pgid rc=0 note="" killed=0
  local start last now elapsed d_wall count rss cpu d_cpu rate
  local peak=0 total_cpu=0
  pgid=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')
  case $pgid in ''|*[!0-9]*) pgid="" ;; esac
  start=$(now); last=$start
  read -r count rss cpu <<EOF
$(group_stats "${pgid:-$pid}")
EOF
  last_cpu=${cpu:-0}
  while kill -0 "$pid" 2>/dev/null; do
    sleep 1
    now=$(now); elapsed=$((now - start)); d_wall=$((now - last))
    [ "$d_wall" -ge 1 ] || d_wall=1
    read -r count rss cpu <<EOF
$(group_stats "${pgid:-$pid}")
EOF
    case $count in ''|*[!0-9]*) count=0 ;; esac
    [ "$count" -gt "$peak" ] && peak=$count
    d_cpu=$((cpu - ${last_cpu:-0})); [ "$d_cpu" -lt 0 ] && d_cpu=0
    total_cpu=$((total_cpu + d_cpu * 10))       # milliseconds
    rate=$((d_cpu * 10 / d_wall))                # millicpus
    last_cpu=$cpu; last=$now

    if [ "$B_TIMEOUT" -gt 0 ] && [ "$elapsed" -ge "$B_TIMEOUT" ]; then
      note="timeout after ${elapsed}s (cap ${B_TIMEOUT}s)"; rc=124; killed=1; break
    fi
    if [ "$B_MEM" -gt 0 ] && [ $((rss * 1024)) -gt "$B_MEM" ]; then
      note="memory cap exceeded: $((rss / 1024)) MiB > $((B_MEM / 1048576)) MiB"; rc=137; killed=1; break
    fi
    if [ "$B_CHILDREN" -gt 0 ] && [ "$count" -gt $((B_CHILDREN + 1)) ]; then
      note="children cap exceeded: $((count - 1)) > ${B_CHILDREN}"; rc=125; killed=1; break
    fi
    if [ "$B_CPU" -gt 0 ] && [ "$rate" -gt $((B_CPU * 13 / 10)) ]; then
      local remain=0
      [ "$B_TIMEOUT" -gt 0 ] && remain=$(( (B_TIMEOUT - elapsed - 1) * 1000 ))
      throttle_group "${pgid:-$pid}" "$rate" "$B_CPU" "$remain"
    fi
  done
  if [ "$killed" = 1 ]; then
    kill_tree "$pid" TERM
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 20 ]; do sleep 0.1; i=$((i+1)); done
    kill -0 "$pid" 2>/dev/null && kill_tree "$pid" KILL
  fi
  local wrc=0
  wait "$pid" 2>/dev/null; wrc=$?
  [ "$killed" = 1 ] || rc=$wrc
  setf "$id" peak_children "$peak"
  setf "$id" cpu_ms "$total_cpu"
  [ -n "$note" ] && setf "$id" note "$note"
  return "$rc"
}

# Run the command with the slot held. Assumes acquire_slot already returned 0.
exec_job() { # id cmd...
  local id=$1 rc=0; shift
  export LOCKOUT_JOB=$id
  export LOCKOUT_ACTIVE_SCOPE=$SCOPE
  job_budget "$id"
  # Job control (not a ps walk) gives the command its own process group, so the
  # supervisor and cancel can signal and measure the whole tree with one id.
  set -m
  "$@" &
  CHILD_PID=$!
  set +m
  setf "$id" child "$CHILD_PID"
  supervise "$id" "$CHILD_PID" || rc=$?
  CHILD_PID=""
  finish "$id" "$rc"
  JOB_ID=""
  return "$rc"
}

# A job that shells out to another lockout-wrapped command inside the same
# scope must not queue behind itself. Re-entrant by design.
nested() {
  [ -n "${LOCKOUT_JOB:-}" ] && [ "${LOCKOUT_ACTIVE_SCOPE:-}" = "$SCOPE" ]
}

# ----------------------------------------------------------- subcommands ----

QUIET=0

cmd_run() {
  local tag=""
  init_state
  load_budget_defaults
  while [ $# -gt 0 ]; do
    case $1 in
      -q|--quiet)   QUIET=1; shift ;;
      -t|--tag)     tag=${2:-}; shift 2 ;;
      --no-dedupe)  NO_DEDUPE=1; shift ;;
      --cpu-quota|--mem-cap|--children|--timeout|--task-gate)
                    [ $# -ge 2 ] || die "run: $1 needs a value"
                    budget_flag "$1" "$2"; shift 2 ;;
      --)           shift; break ;;
      -*)           die "run: unknown option '$1'" ;;
      *)          break ;;
    esac
  done
  [ $# -gt 0 ] || die "run: no command given (try: $PROG run -- cargo build)"

  if nested; then
    [ "$QUIET" = 1 ] || warn "already holding slot $LOCKOUT_JOB in scope '$SCOPE'; running inline"
    exec "$@"
  fi

  trap on_exit EXIT
  trap 'on_signal INT 2' INT
  trap 'on_signal TERM 15' TERM
  trap 'on_signal HUP 1' HUP

  # Collapse against an identical job that has not started. Safe precisely
  # because it is still queued: it has read nothing, so whenever it runs it sees
  # the same working tree this caller is asking about. Attaching to a RUNNING job
  # would instead report a verdict computed before any edits since it started.
  local dup=""
  if [ "$NO_DEDUPE" != 1 ]; then
    EXCLUSIVE=$(resolve_exclusive)
    JOB_KEY=$(job_key "$EXCLUSIVE" "$(job_cmd_text "$@")")
    ctl_acquire; dup=$(duplicate_queued "$JOB_KEY"); ctl_release
  fi
  if [ -n "$dup" ]; then
    [ "$QUIET" = 1 ] || warn "identical job $dup is queued; waiting for it instead of running twice (--no-dedupe to force)"
    cmd_wait "$dup"
    return $?
  fi

  # Gate only a job that will actually spawn; a deduped run above never does.
  if ! task_gate_check "$B_CHILDREN"; then
    case $B_TASK_GATE in
      off)  : ;;
      warn) warn "allowing spawn despite ${TASK_REASON}" ;;
      *)    warn "refusing to spawn: ${TASK_REASON} (override: --task-gate warn|off)"
            exit 253 ;;
    esac
  fi

  JOB_ID=$(enqueue run "$tag" "$@")
  acquire_slot "$JOB_ID" || return $?
  exec_job "$JOB_ID" "$@"
}

cmd_submit() {
  local tag=""
  init_state
  load_budget_defaults
  while [ $# -gt 0 ]; do
    case $1 in
      -q|--quiet) QUIET=1; shift ;;
      -t|--tag)   tag=${2:-}; shift 2 ;;
      --cpu-quota|--mem-cap|--children|--timeout|--task-gate)
                  [ $# -ge 2 ] || die "submit: $1 needs a value"
                  budget_flag "$1" "$2"; shift 2 ;;
      --)         shift; break ;;
      -*)         die "submit: unknown option '$1'" ;;
      *)          break ;;
    esac
  done
  [ $# -gt 0 ] || die "submit: no command given"

  if ! task_gate_check "$B_CHILDREN"; then
    case $B_TASK_GATE in
      off)  : ;;
      warn) warn "allowing submit despite ${TASK_REASON}" ;;
      *)    warn "refusing to submit: ${TASK_REASON} (override: --task-gate warn|off)"
            exit 253 ;;
    esac
  fi

  local id child
  id=$(enqueue submit "$tag" "$@")
  : > "$JOBS_DIR/$id/log"
  # The record is enqueued with our pid, so the reaper cannot mistake it for
  # abandoned before the worker takes over on the next line.
  nohup "$SELF" __worker "$id" "$@" >>"$JOBS_DIR/$id/log" 2>&1 &
  child=$!
  set_owner "$id" "$child"
  if [ "$QUIET" = 1 ]; then
    printf '%s\n' "$id"          # scriptable: bare id on stdout
  else
    printf 'submitted %s: %s\n' "$id" "$(getf "$id" cmd)"
  fi
  return 0
}

# Internal: the detached half of `submit`.
cmd_worker() {
  local id=${1:-}; shift
  [ -n "$id" ] || die "__worker: missing job id"
  init_state
  JOB_ID=$id
  QUIET=1
  job_budget "$id"
  if ! task_gate_check "$B_CHILDREN"; then
    case $B_TASK_GATE in
      off)  : ;;
      warn) warn "running despite ${TASK_REASON}" ;;
      *)    setf "$id" note "not started: ${TASK_REASON}"
            finish "$id" 253 "not started: ${TASK_REASON}"
            JOB_ID=""
            return 253 ;;
    esac
  fi
  # Same pid the submitter recorded (nohup exec's, so the pid and its start
  # time survive); rewriting it keeps the record right if submit died early.
  set_owner "$id" "$$"
  trap on_exit EXIT
  trap 'on_signal INT 2' INT
  trap 'on_signal TERM 15' TERM
  trap 'on_signal HUP 1' HUP
  acquire_slot "$id" || return $?
  exec_job "$id" "$@"
}

# Emit one row per job. Callers hold no lock; a torn read just shows stale
# state for one tick, which is fine for a status display.
# Fields are separated by US (\037), not tab: tab is an IFS whitespace
# character, so bash would collapse adjacent tabs and shift every field after
# an empty one.
status_rows() { # -> id US state US wait US run US pid US exit US cwd US cmd US tag US note
  local d id st q s e t wait run cwd cmd tag note pid rc
  t=$(now)
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    id=${d%/}; id=${id##*/}
    rf "$d/state"; st=$RF
    [ -n "$st" ] || continue
    rf "$d/queued_at"; q=$RF; case $q in ''|*[!0-9]*) q=$t ;; esac
    rf "$d/started";   s=$RF
    rf "$d/ended";     e=$RF
    rf "$d/pid";       pid=$RF
    rf "$d/exit";      rc=$RF
    rf "$d/tag";       tag=$RF
    rf "$d/note";      note=$RF
    # Explain a wait that is not simply "no free slot": a job blocked on an
    # exclusive build directory would otherwise look mysteriously stuck behind
    # a queue that appears to have room.
    if [ "$st" = queued ] && [ -z "$note" ]; then
      rf "$d/exclusive"
      if [ -n "$RF" ] && exclusive_busy "$id" "$RF"; then
        note="waiting on build dir $RF"
      fi
    fi
    cwd=$(getf "$id" cwd)
    cmd=$(getf "$id" cmd)
    case $s in ''|*[!0-9]*) wait=$((t - q)); run=-1 ;;
      *) wait=$((s - q))
         case $e in ''|*[!0-9]*) run=$((t - s)) ;; *) run=$((e - s)) ;; esac ;;
    esac
    cmd=${cmd//$US/ }; cwd=${cwd//$US/ }; tag=${tag//$US/ }; note=${note//$US/ }
    printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
      "$id" "$US" "$st" "$US" "$wait" "$US" "$run" "$US" "${pid:-}" "$US" \
      "${rc:-}" "$US" "$cwd" "$US" "$cmd" "$US" "$tag" "$US" "$note"
  done
  return 0
}

cmd_status() {
  local json=0 all=0 showpath=0
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=1; shift ;;
      -a|--all) all=1; shift ;;
      -p|--path) showpath=1; shift ;;
      *) die "status: unknown option '$1'" ;;
    esac
  done
  init_state
  ctl_acquire; reap; ctl_release

  local limit running queued
  limit=$(get_limit)
  ctl_acquire
  running=$(count_state running)
  queued=$(count_state queued)
  ctl_release

  if [ "$json" = 1 ]; then
    printf '{"scope":"%s","dir":"%s","limit":%s,"running":%s,"queued":%s,"jobs":[' \
      "$(json_escape "$SCOPE")" "$(json_escape "$SCOPE_DIR")" "$limit" "$running" "$queued"
    local first=1 id st w r pid rc cwd cmd tag note
    while IFS=$US read -r id st w r pid rc cwd cmd tag note; do
      # An empty command substitution still feeds the heredoc one blank line;
      # without this guard a scope with no jobs emits a phantom record and
      # invalid JSON ("waited":,).
      [ -n "$id" ] || continue
      [ "$all" = 1 ] || [ "$st" != "done" ] || continue
      [ "$first" = 1 ] || printf ','
      first=0
      printf '{"id":"%s","state":"%s","waited":%s,"ran":%s,"pid":%s,"exit":%s,"cwd":"%s","command":"%s","tag":"%s","note":"%s"}' \
        "$id" "$st" "$w" "$r" "${pid:-null}" "${rc:-null}" \
        "$(json_escape "$cwd")" "$(json_escape "$cmd")" \
        "$(json_escape "$tag")" "$(json_escape "$note")"
    done <<EOF
$(status_rows)
EOF
    printf ']}\n'
    return 0
  fi

  printf 'scope %s  limit %s  running %s  queued %s\n' "$SCOPE" "$limit" "$running" "$queued"
  local rows id st w r pid rc cwd cmd tag note disp any=0
  rows=$(status_rows)
  [ -n "$rows" ] || { printf '(no jobs)\n'; return 0; }
  if [ "$showpath" = 1 ]; then
    printf '%-7s %-8s %7s %7s %7s  %-24s %s\n' ID STATE WAIT RUN PID WHERE COMMAND
  else
    printf '%-7s %-8s %7s %7s %7s  %s\n' ID STATE WAIT RUN PID COMMAND
  fi
  while IFS=$US read -r id st w r pid rc cwd cmd tag note; do
    [ -n "$id" ] || continue
    [ "$all" = 1 ] || [ "$st" != "done" ] || continue
    any=1
    case $st in
      done) st="done:${rc:-?}" ;;
    esac
    if [ "$r" -lt 0 ] 2>/dev/null; then disp="-"; else disp=$(hms "$r"); fi
    if [ "$showpath" = 1 ]; then
      printf '%-7s %-8s %7s %7s %7s  %-24s %s\n' \
        "$id" "$st" "$(hms "$w")" "$disp" "${pid:--}" "$(job_where "$cwd")" "${cmd:-?}"
    else
      printf '%-7s %-8s %7s %7s %7s  %s\n' \
        "$id" "$st" "$(hms "$w")" "$disp" "${pid:--}" "${cmd:-?}"
    fi
    [ -n "$note" ] && printf '%-7s %s\n' "" "  ^ $note"
  done <<EOF
$rows
EOF
  [ "$any" = 1 ] || printf '(nothing active; --all to include finished jobs)\n'
  return 0
}

cmd_wait() {
  init_state
  local rc=0 id st
  if [ $# -eq 0 ]; then
    # Drain: block until nothing is queued or running.
    local n
    while :; do
      ctl_acquire; reap
      n=$(count_state running); n=$((n + $(count_state queued)))
      ctl_release
      [ "$n" -eq 0 ] && return 0
      sleep 0.25
    done
  fi
  for id in "$@"; do
    [ -d "$JOBS_DIR/$id" ] || { warn "no such job: $id"; rc=1; continue; }
    while :; do
      ctl_acquire; reap; ctl_release
      st=$(getf "$id" state)
      [ "$st" = "done" ] && break
      sleep 0.25
    done
    local e; e=$(getf "$id" exit)
    case $e in ''|*[!0-9]*) e=1 ;; esac
    [ "$e" -ne 0 ] && rc=$e
  done
  return "$rc"
}

cmd_logs() {
  local follow=0
  while [ $# -gt 0 ]; do
    case $1 in -f|--follow) follow=1; shift ;; -*) die "logs: unknown option '$1'" ;; *) break ;; esac
  done
  local id=${1:-}
  [ -n "$id" ] || die "logs: need a job id"
  local f=$JOBS_DIR/$id/log
  [ -d "$JOBS_DIR/$id" ] || die "no such job: $id"
  if [ ! -f "$f" ]; then
    die "job $id has no log (foreground jobs stream to their own terminal; use 'submit' for logged jobs)"
  fi
  if [ "$follow" = 1 ]; then tail -f "$f"; else cat "$f"; fi
}

cmd_cancel() {
  init_state
  [ $# -gt 0 ] || die "cancel: need a job id (or 'all')"
  local id st pid child targets=""
  if [ "${1:-}" = all ]; then
    local d
    for d in "$JOBS_DIR"/*/; do
      [ -d "$d" ] || continue
      rf "$d/state"
      case $RF in queued|running) d=${d%/}; targets="$targets ${d##*/}" ;; esac
    done
  else
    targets=$*
  fi
  for id in $targets; do
    [ -d "$JOBS_DIR/$id" ] || { warn "no such job: $id"; continue; }
    st=$(getf "$id" state)
    [ "$st" = "done" ] && { warn "job $id already finished"; continue; }
    : > "$JOBS_DIR/$id/cancel"
    child=$(getf "$id" child)
    pid=$(getf "$id" pid)
    if [ "$st" = running ] && alive "$child"; then
      kill_tree "$child" TERM
    elif alive "$pid"; then
      kill -TERM "$pid" 2>/dev/null   # still queued: the waiter cleans up
    fi
    printf 'cancelled %s\n' "$id"
  done
  return 0
}

cmd_limit() {
  init_state
  if [ $# -eq 0 ]; then get_limit; printf '\n'; return 0; fi
  local n=$1
  case $n in ''|*[!0-9]*) die "limit: want a positive integer, got '$n'" ;; esac
  [ "$n" -ge 1 ] || die "limit: want a positive integer, got '$n'"
  printf '%s\n' "$n" > "$SCOPE_DIR/limit" || die "cannot write $SCOPE_DIR/limit"
  printf 'limit for scope %s is now %s\n' "$SCOPE" "$n"
  [ -n "${LOCKOUT_LIMIT:-}" ] && warn "LOCKOUT_LIMIT=$LOCKOUT_LIMIT is set and overrides this for the current environment"
  return 0
}

cmd_reap() {
  init_state
  ctl_acquire; reap; ctl_release
  cmd_status
}

cmd_reset() {
  init_state
  [ "${1:-}" = --force ] || die "reset wipes all state for scope '$SCOPE'; pass --force"
  local d
  for d in "$JOBS_DIR"/*/; do
    [ -d "$d" ] || continue
    rf "$d/pid"
    alive "$RF" && die "refusing to reset: job ${d} is still live (pid $RF). Cancel it first."
  done
  rm -rf "$SCOPE_DIR"
  printf 'reset scope %s\n' "$SCOPE"
}

cmd_budget() {
  init_state
  load_budget_defaults
  local any=0 clear=0
  while [ $# -gt 0 ]; do
    case $1 in
      --clear) clear=1; any=1; shift ;;
      --cpu-quota|--mem-cap|--children|--timeout|--task-gate)
               [ $# -ge 2 ] || die "budget: $1 needs a value"
               budget_flag "$1" "$2"; any=1; shift 2 ;;
      -*)      die "budget: unknown option '$1'" ;;
      *)       die "budget: unknown argument '$1'" ;;
    esac
  done
  if [ "$any" = 1 ]; then
    [ "$clear" = 1 ] && { B_CPU=0; B_MEM=0; B_CHILDREN=0; B_TIMEOUT=0; B_TASK_GATE=on; }
    printf '%s\n' "$B_CPU" > "$SCOPE_DIR/cpu_quota"
    printf '%s\n' "$B_MEM" > "$SCOPE_DIR/mem_cap"
    printf '%s\n' "$B_CHILDREN" > "$SCOPE_DIR/children"
    printf '%s\n' "$B_TIMEOUT" > "$SCOPE_DIR/timeout"
    printf '%s\n' "$B_TASK_GATE" > "$SCOPE_DIR/task_gate"
    printf 'budget for scope %s: cpu=%s millicpus mem=%s bytes children=%s timeout=%ss gate=%s\n' \
      "$SCOPE" "$B_CPU" "$B_MEM" "$B_CHILDREN" "$B_TIMEOUT" "$B_TASK_GATE"
    return 0
  fi
  local count ceiling head limit running queued
  count=$(task_count) || count="?"
  ceiling=$(task_ceiling) || ceiling="?"
  if [ "$count" != "?" ] && [ "$ceiling" != "?" ]; then head=$((ceiling - count)); else head="?"; fi
  limit=$(get_limit)
  ctl_acquire; reap; ctl_release
  running=$(count_state running); queued=$(count_state queued)
  printf 'scope            %s\n' "$SCOPE"
  printf 'queue            limit %s  running %s  queued %s\n' "$limit" "$running" "$queued"
  printf 'cpu_quota        %s millicpus (%s cores)\n' "$B_CPU" "$(printf '%d.%03d' $((B_CPU / 1000)) $((B_CPU % 1000)))"
  printf 'mem_cap          %s bytes (%s MiB)\n' "$B_MEM" "$((B_MEM / 1048576))"
  printf 'children         %s (0 = unlimited)\n' "$B_CHILDREN"
  printf 'timeout          %s s (0 = none)\n' "$B_TIMEOUT"
  printf 'task_gate        %s (reserve %s)\n' "$B_TASK_GATE" "${LOCKOUT_TASK_HEADROOM:-64}"
  printf 'kernel tasks     %s / %s  headroom %s\n' "$count" "$ceiling" "$head"
  return 0
}

# The self-test proves the two failure modes this budget exists for: a spawn
# refused at the table ceiling, and a 20s runaway loop contained well under half
# the machine. It uses a throwaway LOCKOUT_HOME and always cleans its burners.
SELFTEST_TOKEN=""
SELFTEST_TMP=""
cleanup_selftest() {
  [ -n "$SELFTEST_TOKEN" ] && pkill -f "$SELFTEST_TOKEN" 2>/dev/null
  [ -n "$SELFTEST_TMP" ] && rm -rf "$SELFTEST_TMP"
  return 0
}

cmd_self_test() {
  local T nproc half token id wrc rc elapsed cpu_ms peak survives start_ts end_ts
  local pass=0 fail=0
  T=$(mktemp -d "${TMPDIR:-/tmp}/lockout-selftest.XXXXXX") || die "mktemp failed"
  nproc=$(sysctl -n hw.ncpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)
  half=$((nproc / 2)); [ "$half" -ge 1 ] || half=1
  token="lockout-selftest-$$-$(now)"
  SELFTEST_TMP=$T; SELFTEST_TOKEN=$token
  trap cleanup_selftest EXIT INT TERM

  printf 'lockout %s self-test (nproc %s, half %s)\n' "$VERSION" "$nproc" "$half"

  # 1. The gate refuses to spawn when the table has no headroom.
  printf '  %-52s' "refuses a spawn at the task-table ceiling"
  LOCKOUT_HOME=$T LOCKOUT_SCOPE=gate LOCKOUT_TASK_GATE=on \
    LOCKOUT_TASK_CEILING=100 LOCKOUT_TASK_COUNT=99 LOCKOUT_TASK_HEADROOM=64 \
    "$SELF" run -- true >/dev/null 2>&1
  rc=$?
  if [ "$rc" = 253 ]; then pass=$((pass+1)); echo ok
  else fail=$((fail+1)); echo FAIL; echo "      expected 253, got $rc" >&2; fi

  # 2. A runaway loop that wants 20s is cut off at the wall cap, throttled to
  #    its CPU quota meanwhile, and its fan-out held at the children cap.
  printf '  %-52s' "contains a 20s runaway loop under half nproc"
  local loop
  loop="$token; i=0; while [ \$i -lt 8 ]; do (while :; do :; done) & i=\$((i+1)); done; end=\$((SECONDS+20)); while [ \$SECONDS -lt \$end ]; do sleep 1; done; wait"
  id=$(LOCKOUT_HOME=$T LOCKOUT_SCOPE=runaway LOCKOUT_TASK_GATE=off \
       "$SELF" submit -q --cpu-quota 2 --mem-cap 512M --children 12 --timeout 6 \
       -- sh -c "$loop" 2>/dev/null)
  if [ -z "$id" ]; then fail=$((fail+1)); echo FAIL; echo "      submit returned no job id" >&2
  else
    LOCKOUT_HOME=$T LOCKOUT_SCOPE=runaway "$SELF" wait "$id" >/dev/null 2>&1; wrc=$?
    # getf uses the active scope; read directly through LOCKOUT_HOME scope path.
    cpu_ms=$(cat "$T/runaway/jobs/$id/cpu_ms" 2>/dev/null || echo 0)
    peak=$(cat "$T/runaway/jobs/$id/peak_children" 2>/dev/null || echo 0)
    start_ts=$(cat "$T/runaway/jobs/$id/started" 2>/dev/null || echo "$(now)")
    end_ts=$(cat "$T/runaway/jobs/$id/ended" 2>/dev/null || echo "$(now)")
    elapsed=$((end_ts - start_ts))
    survives=$(pgrep -f "$token" 2>/dev/null | wc -l | tr -d ' ')
    if [ "$wrc" = 124 ] && [ "$elapsed" -ge 4 ] && [ "$elapsed" -le 12 ] \
       && [ "$cpu_ms" -le $((half * 1000 * elapsed * 135 / 100)) ] \
       && [ "$peak" -le 13 ] && [ "$peak" -ge 1 ] && [ "$survives" = 0 ]; then
      pass=$((pass+1)); echo ok
      printf '      rc=%s elapsed=%ss cpu=%sms peak_group=%s survivors=%s\n' \
        "$wrc" "$elapsed" "$cpu_ms" "$peak" "$survives"
    else
      fail=$((fail+1)); echo FAIL
      printf '      rc=%s elapsed=%ss cpu=%sms (cap %sms) peak=%s survivors=%s\n' \
        "$wrc" "$elapsed" "$cpu_ms" $((half * 1000 * elapsed * 135 / 100)) "$peak" "$survives" >&2
    fi
  fi

  printf '%s passed, %s failed\n' "$pass" "$fail"
  [ "$fail" -eq 0 ] || return 1
  return 0
}

usage() {
  cat <<'__HELP__'
lockout - queue expensive builds so they do not fight over the machine.

USAGE
  lockout run [-t TAG] [-q] -- CMD [ARGS...]   queue, block, run, exit with CMD's code
  lockout submit [-t TAG] -- CMD [ARGS...]     queue and detach; prints a job id
  lockout status [--json] [--all] [--path]     what is running and what is waiting
                                              --path adds a WHERE column: crate name, or cwd
  lockout wait [ID...]                         block until ID (or everything) is done
  lockout logs [-f] ID                         output of a submitted job
  lockout cancel ID | all                      stop a queued or running job
  lockout limit [N]                            show or set the concurrency limit
  lockout budget [--cpu-quota N] [--mem-cap SIZE] [--children N] [--timeout D]
                 [--task-gate on|warn|off] [--clear]
                                               show or set this scope's default budget
  lockout reap                                 free slots from dead processes
  lockout reset --force                        wipe this scope's state
  lockout self-test                            prove the budget contains a runaway
  lockout version | help

BUDGET (per job; scope defaults via `lockout budget`)
  --cpu-quota N     millicpus are enforced by SIGSTOP/SIGCONT duty cycling
                    (2 = two cores, 0.5 = half a core; 0 = unlimited)
  --mem-cap SIZE    resident set ceiling (512M, 2G, or bytes; 0 = unlimited)
  --children N      maximum descendant processes (0 = unlimited)
  --timeout D       wall-clock limit (90, 30m, 2h; 0 = none)
  --task-gate MODE  on (default) refuses to spawn without kernel-table headroom;
                    warn allows it loudly; off disables the check

The budget is the same queue and the same job record as `lockout run`: there is
no second limiter. A budget stop exits 124 (timeout), 125 (children), 137 (memory),
the task gate exits 253, and a job that cannot be reaped exits 254.

ENVIRONMENT
  LOCKOUT_LIMIT         concurrency limit, overrides the stored one (default 1)
  LOCKOUT_SCOPE         queue name; separate scopes never block each other (default "default")
  LOCKOUT_HOME          state directory (default $XDG_STATE_HOME/lockout or ~/.local/state/lockout)
  LOCKOUT_RETENTION     seconds to keep finished jobs in status (default 3600)
  LOCKOUT_CPU_QUOTA     default CPU quota (millicpus or cores, e.g. 2 / 0.5)
  LOCKOUT_MEM_CAP       default memory cap (e.g. 4G)
  LOCKOUT_CHILDREN      default descendant cap
  LOCKOUT_TIMEOUT       default wall-clock cap
  LOCKOUT_TASK_GATE     on|warn|off (default on)
  LOCKOUT_TASK_HEADROOM kernel-task reserve required before a spawn (default 64)
  LOCKOUT_TASK_CEILING  override kern.num_tasks/kern.maxproc (testing/ops)
  LOCKOUT_TASK_COUNT    override the measured task count (testing only)

NOTES
  Jobs are admitted first-come-first-served. A command run under lockout can
  itself call lockout in the same scope without deadlocking -- the inner call
  detects the held slot and runs inline.

EXAMPLES
  lockout run -- cargo build --release
  lockout run --cpu-quota 4 --mem-cap 8G --children 32 --timeout 30m -- cargo test
  lockout budget --cpu-quota 6 --children 48 --timeout 45m
  lockout limit 2
  id=$(lockout submit -q -- cargo test); lockout wait "$id"; lockout logs "$id"
  watch -n1 lockout status
__HELP__
}

# -------------------------------------------------------------- dispatch ----

SELF=$(self_path)

main() {
  local sub=${1:-help}
  [ $# -gt 0 ] && shift
  case $sub in
    run)        cmd_run "$@" ;;
    submit)     cmd_submit "$@" ;;
    __worker)   cmd_worker "$@" ;;
    status|st)  cmd_status "$@" ;;
    wait)       cmd_wait "$@" ;;
    logs|log)   cmd_logs "$@" ;;
    cancel|kill) cmd_cancel "$@" ;;
    limit)      cmd_limit "$@" ;;
    budget)     cmd_budget "$@" ;;
    reap)       cmd_reap "$@" ;;
    reset)      cmd_reset "$@" ;;
    self-test|selftest) cmd_self_test "$@" ;;
    version|--version|-V) printf '%s %s\n' "$PROG" "$VERSION" ;;
    help|--help|-h) usage ;;
    *) printf '%s: unknown command '\''%s'\''\n\n' "$PROG" "$sub" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
